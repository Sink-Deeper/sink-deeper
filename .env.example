PORT=3000
# Directory for the SQLite db and audio files
DATA_DIR=./data
# Max upload size in MB
MAX_UPLOAD_MB=500
# Set to 1 to keep the original uploaded file alongside the transcoded stream copy
KEEP_ORIGINALS=0
# Public base URL used for share/embed links (optional)
PUBLIC_URL=http://localhost:5173
# Set to 0 only while serving over plain HTTP (before a domain + HTTPS is configured)
COOKIE_SECURE=1

# --- Optional: Bunny.net media storage + CDN. Leave unset to keep media on local disk.
# Generate with: BUNNY_API_KEY=... deploy/bunny-provision.py <zone-name> <region>
# BUNNY_STORAGE_ZONE=your-storage-zone
# BUNNY_STORAGE_HOST=storage.bunnycdn.com
# BUNNY_STORAGE_KEY=
# BUNNY_CDN_HOST=your-pull-zone.b-cdn.net
# BUNNY_TOKEN_KEY=
# Optional account API key: enables instant CDN purge when an audio is deleted
# BUNNY_API_KEY=

# --- Abuse limits (defaults shown) ---
# MAX_UPLOADS_PER_DAY=20            # per user
# MAX_UPLOADS_PER_10MIN=5           # per user, burst
# USER_QUOTA_MB=5120                # total stored audio per user
# MAX_DOWNLOADS_PER_HOUR=30         # per listener (owner/admin exempt)
# MAX_REGISTRATIONS_PER_IP_PER_DAY=5
# MAX_LOGIN_ATTEMPTS_PER_15MIN=10   # per IP
# MAX_COMMENTS_PER_HOUR=30          # per user
# MAX_PLAYLISTS_PER_USER=100
# MAX_PLAYLIST_ITEMS=500
# MAX_API_PER_MIN_PER_IP=600
# MAX_WRITES_PER_HOUR=300           # likes/follows/playlist edits per user
# MAX_LOGIN_FAILURES_PER_ACCOUNT_PER_15MIN=20
# MAX_MEDIA_PER_MIN_PER_IP=300
# MAX_DURATION_MIN=360              # longest audio accepted
# FFMPEG_TIMEOUT_MIN=30
# ANALYTICS_RETENTION_DAYS=400
# HOST=127.0.0.1                    # bind address (Caddy proxies to it)
